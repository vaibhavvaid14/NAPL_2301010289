open System

[<EntryPoint>]
let main argv =
    // Test lists
    let list1 = [ 1; 2; 3; 4; 5; 6 ]
    let list2 = [ -3; 0; 4; 7; 10; 15 ]
    let list3 = [ 12; -5; 8; 25; 3 ]

    printfn "=== 1. List.map: Square each element ==="
    let squared1 = List.map (fun x -> x * x) list1
    let squared2 = List.map (fun x -> x * x) list2
    printfn "Input %A -> Squared: %A" list1 squared1
    printfn "Input %A -> Squared: %A\n" list2 squared2

    printfn "=== 2. List.filter: Retain only even numbers ==="
    let evens1 = List.filter (fun x -> x % 2 = 0) list1
    let evens2 = List.filter (fun x -> x % 2 = 0) list2
    printfn "Input %A -> Even numbers: %A" list1 evens1
    printfn "Input %A -> Even numbers: %A\n" list2 evens2

    printfn "=== 3. List.fold: Aggregate (Sum, Product, and Max) ==="
    // Sum using List.fold
    let sum1 = List.fold (fun acc x -> acc + x) 0 list1
    let sum2 = List.fold (fun acc x -> acc + x) 0 list2

    // Product using List.fold
    let prod1 = List.fold (fun acc x -> acc * x) 1 list1
    let prod3 = List.fold (fun acc x -> acc * x) 1 list3

    // Maximum using List.fold with first element as initial accumulator
    let max2 = List.fold (fun acc x -> if x > acc then x else acc) list2.Head list2
    let max3 = List.fold (fun acc x -> if x > acc then x else acc) list3.Head list3

    printfn "List %A -> Sum: %d | Product: %d" list1 sum1 prod1
    printfn "List %A -> Sum: %d | Max: %d" list2 sum2 max2
    printfn "List %A -> Product: %d | Max: %d" list3 prod3 max3

    0
